<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Opening: the cloud on black, 96 points wide in the middle - where the
	     page's own loading screen draws it, so the one runs into the other. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBlack</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
	</dict>
	<!-- Keeps music and audiobooks playing with the phone locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- Photo backup carries on when iOS chooses (PhotoBackup). -->
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.soundstorm.app.photobackup</string>
	</array>
	<!-- soundstorm://link?server=&code=: a TV's sign-in code, from the page in Safari. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.soundstorm.app.link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>soundstorm</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>EmberStorm scans a TV's sign-in code, so you can sign the TV in from this phone.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>EmberStorm backs up your photos and videos to your own server, when you turn on photo backup in Settings.</string>
	<!-- Plain http only to the local network (IP addresses, .local names).
	     Everywhere else iOS insists on https, as the web app already does. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Only the system's own https, which is exempt: this answers App Store
	     Connect's export question once instead of on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>EmberStorm connects to your own server, which may be on your home network.</string>
</dict>
</plist>
