<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A TV's sign-in code and a family invitation, scanned with the camera,
	     open in the app: the names service answers for both names' roots
	     (apple-app-site-association, /link/* and /invite/* only). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:*.home.soundstorm.dev</string>
		<string>applinks:*.net.soundstorm.dev</string>
		<!-- Open my SoundStorm on soundstorm.dev: names.soundstorm.dev/open?to= -->
		<string>applinks:names.soundstorm.dev</string>
		<!-- The same on emberstorm.app, the addresses since the rename. -->
		<string>applinks:*.home.emberstorm.app</string>
		<string>applinks:*.net.emberstorm.app</string>
		<string>applinks:names.emberstorm.app</string>
	</array>
</dict>
</plist>
