[Unit]
Description=EmberStorm: the box's own network name, from its serial
After=avahi-daemon.service soundstorm-storage.service network-online.target
Wants=avahi-daemon.service

[Service]
ExecStart=/usr/local/lib/soundstorm/ownname.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
