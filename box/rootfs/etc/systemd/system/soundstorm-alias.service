[Unit]
Description=EmberStorm: soundstorm.local, the box's old name, still answering
After=avahi-daemon.service network-online.target soundstorm-name.service
Wants=avahi-daemon.service

[Service]
ExecStart=/usr/local/lib/soundstorm/alias.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
